# Backend configuration. Copy to .env and fill in real values.
# Every variable without a default is validated at boot by src/config/env.ts
# and the process will refuse to start if it is missing or malformed.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://nyayo:change-me@localhost:5432/nyayo_sentinel

# --- JWT ----------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# All three must be at least 32 characters and must differ from each other.
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
# Separate secret for CSRF tokens. Reusing a signing key across two primitives
# means a weakness in either compromises both. Must differ from the two above.
CSRF_SECRET=
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# --- HTTP ---------------------------------------------------------------
# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- MFA ----------------------------------------------------------------
# Shown to users in their authenticator app.
MFA_ISSUER=NyayoSentinel

# --- Email (Gmail SMTP) -------------------------------------------------
# Use a Gmail App Password, never an account password.
# If unset, email sending is skipped with a warning rather than failing.
SMTP_USER=
SMTP_PASS=

# --- Scraper ingest -----------------------------------------------------
# Must match scraper/.env SCRAPER_API_KEY. Minimum 32 characters.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
SCRAPER_API_KEY=
INGEST_RATE_LIMIT_RPM=10

# --- LLM (optional) -----------------------------------------------------
# Enables AI alert summaries and the national daily briefing.
# Left unset, both degrade gracefully to no summary.
OPENAI_API_KEY=
