generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  role              UserRole
  countyId          String?
  firstName         String?
  lastName          String?
  mfaEnabled        Boolean   @default(true)
  mfaSecret         String?
  otpCode           String?
  otpExpiry         DateTime?
  otpAttempts       Int       @default(0)
  // Invite and reset tokens are stored as SHA-256 hashes, never in the clear:
  // a database read would otherwise be enough to take over any account. They
  // are high-entropy UUIDs, so a fast hash is appropriate and keeps the lookup
  // a single indexed equality match.
  inviteTokenHash   String?   @unique
  inviteTokenExpiry DateTime?
  mustSetPassword   Boolean   @default(false)
  resetTokenHash    String?   @unique
  resetTokenExpiry  DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  county            County?   @relation(fields: [countyId], references: [id])
  auditLogs         AuditLog[]
  revokedTokens     RevokedToken[]
}

/// Denylist for refresh tokens that have been rotated or explicitly logged out.
/// Refresh tokens were previously stateless and unrevocable: logout only
/// cleared cookies, so a stolen token stayed valid for its full 7 day life.
model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

enum UserRole {
  NATIONAL_ADMIN
  COUNTY_OFFICIAL
  ANALYST
}

model County {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  region    String?

  sentimentEvents SentimentEvent[]
  constituencies  Constituency[]
  subCounties     SubCounty[]
  alerts          Alert[]
  alertThresholds AlertThreshold[]
  users           User[]
}

model Constituency {
  id       String @id @default(cuid())
  name     String
  code     String @unique
  countyId String

  county          County           @relation(fields: [countyId], references: [id])
  sentimentEvents SentimentEvent[]

  @@index([countyId])
}

model SubCounty {
  id       String @id @default(cuid())
  name     String
  code     String @unique
  countyId String

  county          County           @relation(fields: [countyId], references: [id])
  sentimentEvents SentimentEvent[]

  @@index([countyId])
}

model Topic {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  isActive  Boolean  @default(true)

  sentimentEvents SentimentEvent[]
  alerts          Alert[]
  alertThresholds AlertThreshold[]
}

model SentimentEvent {
  id               String        @id @default(cuid())
  countyId         String
  topicId          String
  constituencyId   String?
  subCountyId      String?
  timestamp        DateTime      @default(now())
  sentimentScore   Float
  sentimentLabel   SentimentLabel
  source           String
  volumeWeight     Int           @default(1)
  headline         String?       @db.VarChar(220)
  snippet          String?       @db.VarChar(500)

  county           County        @relation(fields: [countyId], references: [id])
  topic            Topic         @relation(fields: [topicId], references: [id])
  constituency     Constituency? @relation(fields: [constituencyId], references: [id])
  subCounty        SubCounty?    @relation(fields: [subCountyId], references: [id])

  @@index([timestamp])
  @@index([countyId])
  @@index([topicId])
  @@index([constituencyId])
  @@index([subCountyId])
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model AlertThreshold {
  id           String         @id @default(cuid())
  countyId     String?
  topicId      String?
  metricType   MetricType
  thresholdVal Float
  severity     AlertSeverity
  active       Boolean        @default(true)
  /// Minimum events in the window before a rule may fire. A spike factor of
  /// 5.0 computed from one event against five is noise, not a signal.
  minVolume    Int            @default(20)
  /// How long after firing the same county and topic stays suppressed.
  /// Previously suppression lasted until the alert was resolved, so an alert
  /// nobody closed silenced its county indefinitely.
  cooldownMinutes Int         @default(360)

  county       County?        @relation(fields: [countyId], references: [id])
  topic        Topic?         @relation(fields: [topicId], references: [id])

  /// Backed by UNIQUE NULLS NOT DISTINCT in the migration. Prisma cannot
  /// express that, and its default treats nulls as distinct, so two "all
  /// counties" rules would not collide here but do collide in the database.
  /// The stricter behaviour is the intended one: null means "all".
  @@unique([countyId, topicId, metricType], map: "AlertThreshold_scope_metric_key")
  @@index([active])
}

enum MetricType {
  NEGATIVE_PERCENT
  SPIKE_FACTOR
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Alert {
  id           String        @id @default(cuid())
  countyId     String
  topicId      String?
  severity     AlertSeverity
  triggerType  TriggerType
  triggeredAt  DateTime      @default(now())
  status       AlertStatus   @default(OPEN)
  summary      String
  llmSummary   String?

  /// Structured record of what fired the rule. The values were previously
  /// recoverable only by regexing the human-readable summary, which broke as
  /// soon as anyone reworded it.
  metricType     MetricType?
  observedValue  Float?
  thresholdValue Float?
  baselineValue  Float?
  eventCount     Int?
  windowStart    DateTime?
  windowEnd      DateTime?
  thresholdId    String?

  /// Re-triggering inside the cooldown bumps these instead of creating a
  /// duplicate row, so a persistent condition reads as one ongoing alert.
  lastSeenAt      DateTime?
  occurrenceCount Int          @default(1)

  county       County        @relation(fields: [countyId], references: [id])
  topic        Topic?        @relation(fields: [topicId], references: [id])

  @@index([status])
  @@index([countyId])
  @@index([topicId])
  @@index([triggeredAt])
}

enum TriggerType {
  THRESHOLD
  SPIKE
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  timestamp    DateTime @default(now())
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?

  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
  @@index([action, timestamp])
}

