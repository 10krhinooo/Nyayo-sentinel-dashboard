# Root compose configuration. Copy to .env alongside docker-compose.yml.
# Service-level configuration lives in backend/.env, frontend/.env.local and
# scraper/.env — see the .env.example in each directory.

# Postgres credentials. POSTGRES_PASSWORD has no default on purpose: compose
# refuses to start without it rather than falling back to a known password.
POSTGRES_USER=nyayo
POSTGRES_PASSWORD=
POSTGRES_DB=nyayo_sentinel

# Connection string handed to the backend container. The host must be the
# compose service name, not localhost. Keep the credentials here in sync with
# POSTGRES_USER and POSTGRES_PASSWORD above.
DATABASE_URL=postgres://nyayo:change-me@postgres:5432/nyayo_sentinel

# Base URL of the backend as reachable from the browser. Baked into the
# frontend bundle at image build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
